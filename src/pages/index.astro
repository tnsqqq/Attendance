---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page-shell">
		<header class="topbar">
			<a class="brand" href="/" aria-label="Attend home">
				<span class="brand-mark" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none">
						<path d="M5 5.5h14v14H5z" />
						<path d="m8.5 12 2.2 2.2 5-5" />
					</svg>
				</span>
				<span>attend<span class="brand-period">.</span></span>
			</a>
			<span class="topbar-note"><span class="live-dot"></span> Your personal attendance tracker</span>
		</header>

		<div class="hero">
			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow">A LITTLE CLARITY GOES A LONG WAY</p>
				<h1 id="page-title">Stay on top of <span>showing up.</span></h1>
				<p class="intro-copy">
					Know where you stand, what it takes to reach your goal, and how much room you have to breathe.
				</p>
				<a class="hero-cta" href="#classes-held">
					Check my attendance <span aria-hidden="true">↗</span>
				</a>
			</section>

			<section class="calculator" aria-label="Attendance calculator">
				<div class="input-panel">
					<div class="panel-heading">
						<div>
							<p class="section-kicker">YOUR NUMBERS</p>
							<h2>Let’s do the math.</h2>
						</div>
						<span class="edit-icon" aria-hidden="true">
							<svg viewBox="0 0 20 20" fill="none">
								<path d="M11.8 4.2 15.8 8.2M3.3 16.7l3.9-.8L16 7.1a1.7 1.7 0 0 0-2.4-2.4l-8.8 8.8-.8 3.2Z" />
							</svg>
						</span>
					</div>

					<div class="fields">
						<label class="field" for="classes-held">
							<span class="field-label">Classes held</span>
							<span class="input-wrap">
								<input id="classes-held" type="number" min="0" step="1" inputmode="numeric" placeholder="e.g. 24" />
								<span class="input-suffix">classes</span>
							</span>
							<span class="field-hint">Total classes scheduled so far</span>
						</label>

						<label class="field" for="classes-attended">
							<span class="field-label">Classes attended</span>
							<span class="input-wrap">
								<input id="classes-attended" type="number" min="0" step="1" inputmode="numeric" placeholder="e.g. 21" />
								<span class="input-suffix">classes</span>
							</span>
							<span class="field-hint">The ones you showed up for</span>
						</label>

						<label class="field target-field" for="target-percent">
							<span class="field-label">Your attendance goal</span>
							<span class="input-wrap">
								<input id="target-percent" type="number" min="1" max="100" step="1" value="75" inputmode="numeric" />
								<span class="input-suffix">%</span>
							</span>
							<span class="field-hint">The minimum percentage you’re aiming for</span>
						</label>
					</div>

					<div class="privacy-note">
						<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
							<path d="M10 2.5 4 5v4.7c0 3.8 2.6 6.4 6 7.8 3.4-1.4 6-4 6-7.8V5l-6-2.5Z" />
							<path d="m7.5 10 1.7 1.7 3.5-3.5" />
						</svg>
						Your numbers stay in your browser. Nothing is saved or shared.
					</div>
				</div>

				<aside class="result-panel" aria-label="Your attendance outlook" aria-live="polite">
					<div class="result-topline">
						<p class="section-kicker">YOUR OUTLOOK</p>
						<span class="status-pill" id="status-pill">Waiting for your numbers</span>
					</div>

					<div class="result-main">
						<div class="progress-ring" id="progress-ring" role="img" aria-label="Attendance percentage: not calculated">
							<div class="ring-inner">
								<span class="percentage" id="attendance-percent">—</span>
								<span class="ring-caption">attendance</span>
							</div>
						</div>
						<div class="result-message">
							<p class="result-label" id="result-label">Your current rate</p>
							<h2 class="result-value" id="result-value">—</h2>
							<p class="result-copy" id="result-copy">Enter your classes to see how you’re doing.</p>
						</div>
					</div>

					<div class="result-divider"></div>
					<div class="goal-row">
						<div class="goal-icon" aria-hidden="true">
							<svg viewBox="0 0 20 20" fill="none">
								<circle cx="10" cy="10" r="7" />
								<circle cx="10" cy="10" r="3.5" />
								<path d="m10 10 5.8-5.8M12.5 4.2h3.3v3.3" />
							</svg>
						</div>
						<div class="goal-copy">
							<span class="goal-label">Your target</span>
							<strong id="goal-value">75%</strong>
						</div>
						<span class="goal-arrow" aria-hidden="true">→</span>
					</div>
				</aside>
			</section>
		</div>

		<footer class="page-footer">
			<span>Small steps add up.</span>
			<span>Made for your next class <span aria-hidden="true">↗</span></span>
		</footer>
	</main>
</Layout>

<script>
	const heldInput = document.querySelector<HTMLInputElement>('#classes-held');
	const attendedInput = document.querySelector<HTMLInputElement>('#classes-attended');
	const targetInput = document.querySelector<HTMLInputElement>('#target-percent');
	const percentageOutput = document.querySelector<HTMLElement>('#attendance-percent');
	const progressRing = document.querySelector<HTMLElement>('#progress-ring');
	const resultLabel = document.querySelector<HTMLElement>('#result-label');
	const resultValue = document.querySelector<HTMLElement>('#result-value');
	const resultCopy = document.querySelector<HTMLElement>('#result-copy');
	const statusPill = document.querySelector<HTMLElement>('#status-pill');
	const goalValue = document.querySelector<HTMLElement>('#goal-value');

	if (
		!heldInput ||
		!attendedInput ||
		!targetInput ||
		!percentageOutput ||
		!progressRing ||
		!resultLabel ||
		!resultValue ||
		!resultCopy ||
		!statusPill ||
		!goalValue
	) {
		throw new Error('Attendance calculator is missing a required element.');
	}

	const updateCalculator = () => {
		const target = Number(targetInput.value);
		goalValue.textContent = `${targetInput.value || '—'}%`;
		statusPill.className = 'status-pill';

		if (!heldInput.value || !attendedInput.value) {
			percentageOutput.textContent = '—';
			progressRing.style.setProperty('--progress', '0%');
			progressRing.setAttribute('aria-label', 'Attendance percentage: not calculated');
			resultLabel.textContent = 'Your current rate';
			resultValue.textContent = '—';
			resultCopy.textContent = 'Enter your classes to see how you’re doing.';
			statusPill.textContent = 'Waiting for your numbers';
			return;
		}

		const held = Number(heldInput.value);
		const attended = Number(attendedInput.value);

		if (
			!Number.isInteger(held) ||
			!Number.isInteger(attended) ||
			held < 1 ||
			attended < 0 ||
			attended > held ||
			!Number.isFinite(target) ||
			target < 1 ||
			target > 100
		) {
			percentageOutput.textContent = '—';
			progressRing.style.setProperty('--progress', '0%');
			progressRing.setAttribute('aria-label', 'Attendance percentage: invalid input');
			resultLabel.textContent = 'Check your numbers';
			resultValue.textContent = 'Let’s fix that';
			resultCopy.textContent =
				'Use whole numbers, make sure attended classes don’t exceed classes held, and set a goal from 1% to 100%.';
			statusPill.textContent = 'Check your numbers';
			statusPill.classList.add('status-error');
			return;
		}

		const rate = (attended / held) * 100;
		const fraction = target / 100;
		percentageOutput.textContent = `${rate.toFixed(1)}%`;
		progressRing.style.setProperty('--progress', `${Math.min(rate, 100)}%`);
		progressRing.setAttribute('aria-label', `Attendance percentage: ${rate.toFixed(1)}%`);

		if (rate >= target) {
			const safeAbsences = Math.max(0, Math.floor(attended / fraction - held + 1e-9));
			resultLabel.textContent = 'You can still miss';
			resultValue.textContent = String(safeAbsences);
			resultCopy.textContent = `more ${safeAbsences === 1 ? 'class' : 'classes'} and still meet your ${target}% goal.`;
			statusPill.textContent = 'You’re on track';
			statusPill.classList.add('status-good');
		} else if (target === 100) {
			resultLabel.textContent = 'Your current rate';
			resultValue.textContent = 'Not reachable';
			resultCopy.textContent = 'A 100% goal can’t be reached after missing a class.';
			statusPill.textContent = 'Goal out of reach';
			statusPill.classList.add('status-error');
		} else {
			const classesNeeded = Math.ceil((fraction * held - attended) / (1 - fraction));
			resultLabel.textContent = 'Attend these in a row';
			resultValue.textContent = String(classesNeeded);
			resultCopy.textContent = `more ${classesNeeded === 1 ? 'class' : 'classes'} to reach your ${target}% goal.`;
			statusPill.textContent = 'A little catch-up';
			statusPill.classList.add('status-catchup');
		}
	};

	heldInput.addEventListener('input', updateCalculator);
	attendedInput.addEventListener('input', updateCalculator);
	targetInput.addEventListener('input', updateCalculator);
	updateCalculator();
</script>

<style>
	:global(:root) {
		--primary: #9fe870;
		--ink: #0e0f0c;
		--body: #454745;
		--mute: #868685;
		--canvas: #fff;
		--canvas-soft: #e8ebe6;
		--positive-pale: #e2f6d5;
		--positive-deep: #054d28;
		--warning: #ffd11a;
		--warning-content: #4a3b1c;
		--negative-bg: #320707;
		--negative-text: #fff;
	}

	:global(body) {
		background: var(--canvas-soft);
		color: var(--ink);
		overflow-x: clip;
		font-family:
			"Wise Sans", Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	:global(html) {
		overflow-x: clip;
	}

	:global(*) {
		box-sizing: border-box;
	}

	.page-shell {
		display: flex;
		flex-direction: column;
		max-width: 1200px;
		min-height: 100vh;
		margin: 0 auto;
		padding: 0 24px;
	}

	.topbar {
		width: 100vw;
		height: 72px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-left: calc(50% - 50vw);
		padding-inline: max(24px, calc((100vw - 1152px) / 2));
		background: var(--canvas);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.8px;
		text-decoration: none;
	}

	.brand-mark {
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--primary);
	}

	.brand-mark svg {
		width: 19px;
		stroke: var(--ink);
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.brand-period {
		color: var(--ink);
	}

	.topbar-note {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink);
		font-size: 14px;
		font-weight: 600;
	}

	.live-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--primary);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(40px, 7vw, 88px);
		flex: 1;
		padding: 56px 0 64px;
	}

	.intro {
		max-width: 520px;
		margin: 0;
		text-align: left;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--body);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	h1 {
		margin: 24px 0;
		color: var(--ink);
		font-family: "Wise Sans", Inter, system-ui, sans-serif;
		font-size: clamp(52px, 6vw, 72px);
		font-weight: 900;
		letter-spacing: -0.055em;
		line-height: 0.95;
	}

	h1 span {
		display: block;
	}

	.intro-copy {
		max-width: 440px;
		margin: 0;
		color: var(--body);
		font-family: Inter, system-ui, sans-serif;
		font-size: 16px;
		line-height: 1.5;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		min-height: 48px;
		margin-top: 30px;
		padding: 12px 24px;
		border-radius: 24px;
		background: var(--primary);
		color: var(--ink);
		font-family: Inter, system-ui, sans-serif;
		font-size: 16px;
		font-weight: 600;
		line-height: 24px;
		text-decoration: none;
		transition: background-color 150ms ease, transform 150ms ease;
	}

	.hero-cta:hover {
		transform: translateY(-1px);
		background: #cdffad;
	}

	.hero-cta:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	.calculator {
		display: grid;
		min-width: 0;
		gap: 16px;
	}

	.input-panel {
		padding: 28px;
		border: 1px solid var(--ink);
		border-radius: 24px;
		background: var(--canvas);
	}

	.panel-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 24px;
	}

	.panel-heading h2 {
		margin: 8px 0 0;
		font-family: Inter, system-ui, sans-serif;
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.48px;
	}

	.edit-icon {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: var(--canvas-soft);
	}

	.edit-icon svg {
		width: 18px;
		stroke: var(--ink);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px 14px;
	}

	.field {
		display: grid;
		gap: 8px;
	}

	.field-label {
		color: var(--ink);
		font-family: Inter, system-ui, sans-serif;
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
	}

	.input-wrap {
		display: flex;
		align-items: center;
		height: 48px;
		padding: 0 16px;
		border: 1px solid var(--ink);
		border-radius: 12px;
		background: var(--canvas);
	}

	.input-wrap:focus-within {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	input {
		width: 100%;
		height: 100%;
		border: 0;
		outline: 0;
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font: 16px Inter, system-ui, sans-serif;
		font-weight: 600;
	}

	input::placeholder {
		color: var(--mute);
		font-weight: 400;
	}

	input::-webkit-inner-spin-button,
	input::-webkit-outer-spin-button {
		margin: 0;
		-webkit-appearance: none;
	}

	input[type="number"] {
		appearance: textfield;
		-moz-appearance: textfield;
	}

	.input-suffix {
		flex: 0 0 auto;
		color: var(--body);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
	}

	.field-hint {
		color: var(--mute);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
		line-height: 16px;
	}

	.target-field {
		grid-column: 1 / -1;
	}

	.target-field .input-wrap {
		max-width: 180px;
	}

	.target-field input {
		text-align: left;
	}

	.privacy-note {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 22px;
		padding-top: 16px;
		border-top: 1px solid var(--canvas-soft);
		color: var(--mute);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
		line-height: 16px;
	}

	.privacy-note svg {
		width: 18px;
		flex: 0 0 auto;
		stroke: var(--body);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.result-panel {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 220px;
		padding: 24px 28px;
		border-radius: 24px;
		background: var(--ink);
		color: var(--primary);
	}

	.result-panel .section-kicker {
		color: var(--primary);
	}

	.result-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		min-height: 28px;
		padding: 4px 12px;
		border: 0;
		border-radius: 999px;
		background: #454745;
		color: var(--canvas);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
		font-weight: 600;
		line-height: 16px;
		white-space: nowrap;
	}

	.status-good {
		background: var(--positive-pale);
		color: var(--positive-deep);
	}

	.status-catchup {
		background: var(--warning);
		color: var(--warning-content);
	}

	.status-error {
		background: var(--negative-bg);
		color: var(--negative-text);
	}

	.result-main {
		display: flex;
		align-items: center;
		gap: 20px;
		margin: 22px 0;
	}

	.progress-ring {
		--progress: 0%;
		width: 112px;
		height: 112px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: conic-gradient(from -90deg, var(--primary) 0 var(--progress), #454745 var(--progress) 100%);
	}

	.ring-inner {
		width: 92px;
		height: 92px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--ink);
	}

	.percentage {
		color: var(--primary);
		font-family: Inter, system-ui, sans-serif;
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.48px;
		line-height: 1.1;
	}

	.ring-caption {
		margin-top: 4px;
		color: var(--canvas-soft);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
	}

	.result-message {
		min-width: 0;
	}

	.result-label {
		margin: 0 0 5px;
		color: var(--canvas-soft);
		font-family: Inter, system-ui, sans-serif;
		font-size: 14px;
		line-height: 20px;
	}

	.result-value {
		margin: 0;
		color: var(--primary);
		font-family: Inter, system-ui, sans-serif;
		font-size: clamp(24px, 3vw, 36px);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.1;
		overflow-wrap: anywhere;
	}

	.result-copy {
		max-width: 240px;
		margin: 8px 0 0;
		color: var(--canvas-soft);
		font-family: Inter, system-ui, sans-serif;
		font-size: 14px;
		line-height: 20px;
	}

	.result-divider {
		height: 1px;
		background: rgb(255 255 255 / 18%);
	}

	.goal-row {
		display: flex;
		align-items: center;
		gap: 11px;
		padding-top: 16px;
	}

	.goal-icon {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: #454745;
	}

	.goal-icon svg {
		width: 18px;
		stroke: var(--primary);
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.goal-copy {
		display: grid;
		gap: 2px;
	}

	.goal-label {
		color: var(--canvas-soft);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
	}

	.goal-copy strong {
		color: var(--primary);
		font-family: Inter, system-ui, sans-serif;
		font-size: 16px;
		font-weight: 600;
	}

	.goal-arrow {
		margin-left: auto;
		color: var(--primary);
		font-size: 20px;
	}

	.page-footer {
		width: 100vw;
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-left: calc(50% - 50vw);
		padding: 32px max(24px, calc((100vw - 1152px) / 2));
		background: var(--ink);
		color: var(--canvas-soft);
		font-family: Inter, system-ui, sans-serif;
		font-size: 14px;
		line-height: 20px;
	}

	.page-footer span:last-child span {
		margin-left: 3px;
		color: var(--primary);
	}

	@media (max-width: 900px) {
		.page-shell {
			padding: 0 20px;
		}

		.topbar {
			padding-inline: 20px;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 36px;
			max-width: 640px;
			margin: 0 auto;
			padding: 52px 0;
		}

		.intro {
			max-width: 580px;
		}

		h1 {
			font-size: clamp(52px, 9vw, 72px);
		}
	}

	@media (max-width: 520px) {
